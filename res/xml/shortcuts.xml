        android:shortcutShortLabel="@string/shortcut_float" android:shortcutLongLabel="@string/shortcut_float">
        <intent android:action="com.magpie.android.FLOAT" android:targetPackage="com.magpie.android"
            android:targetClass="com.magpie.android.MainActivity"/>
    </shortcut>
    <shortcut android:shortcutId="restart" android:enabled="true" android:icon="@drawable/ic_restart"
