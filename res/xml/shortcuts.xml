        <intent android:action="com.magpie.android.RESTART" android:targetPackage="com.magpie.android"
            android:targetClass="com.magpie.android.MainActivity"/>
    </shortcut>
    <shortcut android:shortcutId="log" android:enabled="true" android:icon="@drawable/ic_doc"
        android:shortcutShortLabel="@string/shortcut_log" android:shortcutLongLabel="@string/shortcut_log">
        <intent android:action="com.magpie.android.SHOW_LOG" android:targetPackage="com.magpie.android"
            android:targetClass="com.magpie.android.MainActivity"/>
