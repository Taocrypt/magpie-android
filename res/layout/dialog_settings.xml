<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/settingsRoot"
        android:background="@drawable/bg_bottom_sheet"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/settings_title"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/settings_subtitle"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings_ports_title"
            android:fontFamily="sans-serif-medium"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_field_group"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="11dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_gateway_port"/>
                <EditText
                    android:textSize="20sp"
                    android:textColor="@color/text_primary"
                    android:id="@+id/settingsGatewayPort"
                    android:background="@null"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:selectAllOnFocus="true"
                    android:maxLength="5"
                    android:inputType="number"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <View
                android:background="@color/app_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="11dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_web_port"/>
                <EditText
                    android:textSize="20sp"
                    android:textColor="@color/text_primary"
                    android:id="@+id/settingsWebPort"
                    android:background="@null"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:selectAllOnFocus="true"
                    android:maxLength="5"
                    android:inputType="number"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_switch_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="72dp"
            android:paddingStart="15dp"
            android:paddingEnd="13dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_lan"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="11.5sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/settings_lan_hint"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/settingsLan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:thumbTint="@color/switch_thumb"
                android:showText="false"
                android:trackTint="@color/switch_track"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_switch_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="72dp"
            android:paddingStart="15dp"
            android:paddingEnd="13dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_mdns"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="11.5sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/settings_mdns_hint"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/settingsMdns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:thumbTint="@color/switch_thumb"
                android:showText="false"
                android:trackTint="@color/switch_track"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_switch_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="70dp"
            android:paddingStart="15dp"
            android:paddingEnd="13dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_compat"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="11.5sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/tools_compat_hint"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/settingsCompat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:thumbTint="@color/switch_thumb"
                android:showText="false"
                android:trackTint="@color/switch_track"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_switch_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="70dp"
            android:paddingStart="15dp"
            android:paddingEnd="13dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_autostart"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="11.5sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/settings_autostart_hint"/>
            </LinearLayout>
            <Switch
                android:id="@+id/settingsAutostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:thumbTint="@color/switch_thumb"
                android:showText="false"
                android:trackTint="@color/switch_track"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/settingsBattery"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_switch_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="70dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_battery"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:id="@+id/settingsBatteryHint"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/menu_battery_hint"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="›"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <Button
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:id="@+id/settingsCancel"
                android:background="@drawable/bg_button_secondary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="@string/settings_cancel"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:stateListAnimator="@null"/>
            <Button
                android:textSize="14sp"
                android:textColor="@color/text_on_accent"
                android:id="@+id/settingsSave"
                android:background="@drawable/bg_button_primary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="@string/settings_save"
                android:layout_weight="1.25"
                android:textAllCaps="false"
                android:layout_marginStart="10dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
