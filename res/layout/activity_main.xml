<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/bg_app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/appBar"
        android:background="@drawable/bg_app_bar"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:elevation="4dp">
        <ImageView
            android:id="@+id/logoBadge"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:background="@drawable/bg_logo_badge"
            android:padding="7dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerInside"
            android:contentDescription="@string/app_name"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.015"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <LinearLayout
                    android:id="@+id/statusChip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_status_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="6dp"
                    android:layout_marginStart="-5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="网关状态，点按可重启或停止">
                <View
                    android:id="@+id/statusDot"
                    android:background="@drawable/status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_starting"
                    android:singleLine="true"
                    android:layout_marginStart="6dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/accent"
                    android:id="@+id/addressText"
                    android:background="@drawable/bg_address_chip"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:contentDescription="@string/address_content_description"
                    android:fontFamily="monospace"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <ImageButton
            android:id="@+id/menuButton"
            android:background="@drawable/bg_icon_button"
            android:padding="11dp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_more_vert"
            android:scaleType="centerInside"
            android:tint="@color/text_primary"
            android:contentDescription="@string/menu"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/webHost"
        android:background="@drawable/bg_web_sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="1dp"
        android:clipToOutline="true">
        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/overlay"
            android:background="@color/app_bg"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/overlayCard"
                android:background="@drawable/bg_overlay_card"
                android:paddingTop="32dp"
                android:paddingBottom="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:elevation="4dp">
                <ProgressBar
                    android:id="@+id/overlayProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/accent"/>
                <ImageView
                    android:id="@+id/overlayMark"
                    android:visibility="gone"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/app_name"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:id="@+id/overlayText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/status_starting"
                    android:lineSpacingExtra="3dp"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/text_on_accent"
                    android:id="@+id/overlayButton"
                    android:background="@drawable/bg_button_primary"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:minWidth="132dp"
                    android:text="@string/retry"
                    android:textAllCaps="false"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
